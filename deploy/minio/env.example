# Copy to .env in this directory, on the VPS. Never commit the real file.

# Admin credentials. These stay on the VPS; the app gets a scoped key instead
# (bootstrap.sh creates it). Generate with: openssl rand -base64 32
MINIO_ROOT_USER="wizzadmin"
MINIO_ROOT_PASSWORD="change-me-to-something-long"

# Public hostnames served by your existing reverse proxy.
S3_DOMAIN="s3.example.com"
CONSOLE_DOMAIN="console.example.com"

# Origins allowed to upload from a browser: your production app plus local dev.
# Comma-separated, no spaces, no trailing slashes.
CORS_ORIGINS="https://wizztech.example.com,http://localhost:3000"

# Where the objects live on the host disk. Must be on real storage, not a
# container volume. Create it first: mkdir -p /srv/minio/data
MINIO_DATA_DIR="/srv/minio/data"

BUCKET="wizztech-documents"
APP_USER="wizztech-app"
