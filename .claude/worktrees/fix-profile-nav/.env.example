NEON_DATABASE_URL="postgresql://..."
SESSION_SECRET="a_long_random_string_at_least_32_chars"

# Object storage for document requests (any S3-compatible provider).
# Cloudflare R2: endpoint is https://<account_id>.r2.cloudflarestorage.com and region is "auto".
# Self-hosted MinIO: endpoint is your server URL, region can be anything (e.g. "us-east-1").
# The bucket must be private, and needs a CORS rule allowing PUT/GET from the app's origin.
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="wizztech-documents"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."

# Web Push. Generate a keypair once with:  npx web-push generate-vapid-keys
# The same pair must be used everywhere — regenerating invalidates every
# existing subscription, so devices would silently stop receiving anything.
# VAPID_SUBJECT must be a mailto: or https: URL the push service can contact.
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:you@example.com"
